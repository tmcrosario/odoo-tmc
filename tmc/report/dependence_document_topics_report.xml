<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Default A4 sets header_spacing equal to margin_top, hiding the header -->
    <record id="paperformat_tmc_report" model="report.paperformat">
        <field name="name">TMC Report A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">32</field>
        <field name="margin_bottom">26</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_spacing">9</field>
        <field name="header_line" eval="False" />
        <field name="dpi">90</field>
    </record>

    <record id="action_dependence_document_topics_report" model="ir.actions.report">
        <!-- Spanish inline: ir.actions.report,name won't re-import from the po -->
        <field name="name">Temas por Dependencia</field>
        <field name="model">tmc.dependence</field>
        <field name="report_name">tmc.dependence_document_topics_report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="paperformat_tmc_report" />
        <field name="binding_model_id" ref="model_tmc_dependence" />
        <field name="binding_type">report</field>
        <field name="print_report_name">'Temas_por_Dependencia'</field>
    </record>
</odoo>
