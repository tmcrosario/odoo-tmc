<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="tmc.dependence_view_list" model="ir.ui.view">
        <field name="name">tmc.dependence.view.list</field>
        <field name="model">tmc.dependence</field>
        <field name="arch" type="xml">
            <list string="Dependences">
                <field name="name" />
                <field name="abbreviation" />
                <field name="in_actual_nomenclator" />
            </list>
        </field>
    </record>

    <record id="dependence_document_topic_view_list" model="ir.ui.view">
        <field name="name">tmc.dependence.document.topic.view.list</field>
        <field name="model">tmc.dependence</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="document_topic_names" />
            </list>
        </field>
    </record>

    <record id="dependence_view_form" model="ir.ui.view">
        <field name="name">tmc.dependence.view.form</field>
        <field name="model">tmc.dependence</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <h2>
                        <field name="display_name" invisible="name == False" />
                    </h2>
                    <group>
                        <group>
                            <field name="name" class="oe_edit_only" />
                            <field name="abbreviation" />
                            <field name="in_actual_nomenclator" />
                        </group>
                    </group>
                    <notebook>
                        <page name="document_types" string="Document Types">
                            <field name="document_type_ids" />
                        </page>
                        <page name="systems" string="Systems">
                            <field name="system_ids" />
                        </page>
                        <page name="document_topics" string="Document Topics">
                            <field name="document_topic_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="dependence_view_search">
        <field name="name">tmc.dependence.view.search</field>
        <field name="model">tmc.dependence</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="abbreviation" />
                <filter
                    string="Nomenclador Actual"
                    name="filter_actual_nomenclator"
                    domain="[('in_actual_nomenclator', '=', True)]"
                />
                <filter
                    string="Dependencias con Temas"
                    name="filter_dependences_with_topics"
                    domain="[('document_topic_ids', '!=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="dependence_action_form" model="ir.actions.act_window">
        <field name="name">Dependences</field>
        <field name="res_model">tmc.dependence</field>
        <field name="view_mode">list</field>
        <field name="context">
            {'search_default_filter_dependences_with_topics': True}
        </field>
    </record>

    <record id="dependence_action_form_2" model="ir.actions.act_window">
        <field name="name">Dependences</field>
        <field name="res_model">tmc.dependence</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
