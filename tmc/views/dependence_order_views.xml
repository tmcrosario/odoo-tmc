<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="dependence_order_action_form" model="ir.actions.act_window">
        <field name="name">Dependences in Actual Nomenclator</field>
        <field name="res_model">tmc.dependence_order</field>
        <field name="view_mode">list,form</field>
        <field name="context">
            { 'search_default_filter_actual_nomenclator': True, 'search_default_group_by_parent_id': True }
        </field>
        <field
            name="domain"
        >[('parent_id', '!=', False), (u'parent_id', u'not ilike', u'ADMINISTRACI\xd3N CENTRAL')]
        </field>
    </record>

    <record id="dependence_order_view_form" model="ir.ui.view">
        <field name="name">tmc.dependence_order.view.form</field>
        <field name="model">tmc.dependence_order</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="parent_id" />
                            <field name="dependence_id" class="oe_edit_only" />
                            <field name="name" />
                        </group>
                        <group>
                            <field name="code" />
                            <field name="abbreviation" />
                        </group>
                        <group>
                            <field
                                name="institutional_classifier_ids"
                                widget="many2many_tags"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="dependence_order_view_search">
        <field name="name">tmc.dependence_order.view.search</field>
        <field name="model">tmc.dependence_order</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="name" />
                <field name="abbreviation" />
                <field name="institutional_classifier_ids" />
                <filter
                    name="group_by_parent_id"
                    string="Unidad Institucional"
                    context="{'group_by': 'parent_id'}"
                />
                <filter
                    string="Nomenclador Actual"
                    name="filter_actual_nomenclator"
                    domain="[('in_actual_nomenclator', '=', True)]"
                />
            </search>
        </field>
    </record>

    <record id="dependence_order_view_list" model="ir.ui.view">
        <field name="name">tmc.dependence_order.view.list</field>
        <field name="model">tmc.dependence_order</field>
        <field name="arch" type="xml">
            <list
                string="Dependence Orders"
                decoration-bf="parent_name in [u'ADMINISTRACIÓN CENTRAL', u'ORGANISMOS DESCENTRALIZADOS', u'INSTITUCIONES DE SEGURIDAD SOCIAL', u'EMPRESAS, SOCIEDADES Y OTROS ENTES DEL ESTADO', False]"
            >
                <field name="code" />
                <field name="name" />
                <field name="abbreviation" />
                <field name="institutional_classifier_ids" widget="many2many_tags" />
                <field name="parent_name" invisible="1" />
            </list>
        </field>
    </record>
</odoo>
