<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="institutional_classifier_action_form" model="ir.actions.act_window">
        <field name="name">Nomenclators</field>
        <field name="res_model">tmc.institutional_classifier</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="institutional_classifier_view_list" model="ir.ui.view">
        <field name="name">tmc.institutional_classifier.view.list</field>
        <field name="model">tmc.institutional_classifier</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name" />
                <field name="due_date" options="{'numeric': True}" />
            </list>
        </field>
    </record>

    <record id="institutional_classifier_view_form" model="ir.ui.view">
        <field name="name">tmc.institutional_classifier.view.form</field>
        <field name="model">tmc.institutional_classifier</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h2>
                        <field name="display_name" />
                    </h2>
                    <group>
                        <group>
                            <field name="period" />
                            <field name="due_date" options="{'numeric': True}" />
                            <field name="document_id" />
                        </group>
                        <group>
                            <field name="pdf" filename="display_name" nolabel="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Dependences">
                            <field name="dependence_order_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="institutional_classifier_view_search">
        <field name="name">institutional_classifier.view.search</field>
        <field name="model">tmc.institutional_classifier</field>
        <field name="arch" type="xml">
            <search>
                <field name="period" />
            </search>
        </field>
    </record>

    <record id="tmc.institutional_classifier_view_list" model="ir.ui.view">
        <field name="name">tmc.institutional_classifier.view.list</field>
        <field name="model">tmc.institutional_classifier</field>
        <field name="arch" type="xml">
            <list string="Nomenclators">
                <field name="display_name" />
                <field name="due_date" options="{'numeric': True}" />
            </list>
        </field>
    </record>
</odoo>
