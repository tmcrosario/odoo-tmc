<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_employee_action_form" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">tmc.hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="context">
            { 'search_default_group_by_office_id': True}
        </field>
    </record>

    <record id="hr_employee_view_list" model="ir.ui.view">
        <field name="name">tmc.hr.employee.view.list</field>
        <field name="model">tmc.hr.employee</field>
        <field name="arch" type="xml">
            <list expand="True">
                <field name="name" />
                <field name="email" />
                <field name="internal_number" />
                <field name="employee_job_id" />
            </list>
        </field>
    </record>

    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">tmc.hr.employee.view.form</field>
        <field name="model">tmc.hr.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <field
                        name="employee_title_ids"
                        widget="many2many_tags"
                        options="{'no_create_edit': True}"
                    />
                    <group>
                        <group>
                            <field name="email" widget="email" />
                            <field name="internal_number" />
                        </group>
                    </group>
                    <group>
                        <group string="Posición">
                            <field name="employee_job_id" />
                            <field name="office_id" />
                        </group>
                        <group
                            string="Administración"
                            groups="tmc.group_personal,tmc.group_manager"
                        >
                            <field
                                name="docket_number"
                                options="{'enable_formatting': False}"
                            />
                            <field name="admission_date" options="{'numeric': True}" />
                            <field name="bank_account_number" />
                            <field
                                name="bank_branch"
                                options="{'enable_formatting': False}"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_employee_view_search" model="ir.ui.view">
        <field name="name">tmc.hr.employee.view.search</field>
        <field name="model">tmc.hr.employee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    name="group_by_office_id"
                    string="Oficina"
                    context="{'group_by':'office_id'}"
                />
            </search>
        </field>
    </record>
</odoo>
