<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_tmc" model="ir.module.category">
        <field name="name">TMC</field>
        <field name="sequence">1</field>
    </record>

    <record id="res_groups_privilege_tmc" model="res.groups.privilege">
        <field name="name">GD</field>
        <field name="category_id" ref="module_category_tmc" />
    </record>

    <record id="group_read_only" model="res.groups">
        <field name="name">Read Only</field>
        <field name="privilege_id" ref="res_groups_privilege_tmc" />
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_tmc" />
        <field
            name="implied_ids"
            eval="[(4, ref('base.group_user')), (4, ref('group_read_only'))]"
        />
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_tmc" />
        <field name="implied_ids" eval="[(4, ref('group_user'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]" />
    </record>

    <record id="group_personal" model="res.groups">
        <field name="name">Personal</field>
        <field name="implied_ids" eval="[(4, ref('group_user'))]" />
    </record>

    <record id="group_hidden_elements" model="res.groups">
        <field name="name">Hidden Elements</field>
    </record>

    <!-- Baseline: every internal user gets read-only on GD -->
    <function model="res.groups" name="write">
        <value model="res.groups" eval="[ref('base.group_user')]" />
        <value eval="{'implied_ids': [(4, ref('group_read_only'))]}" />
    </function>
</odoo>
